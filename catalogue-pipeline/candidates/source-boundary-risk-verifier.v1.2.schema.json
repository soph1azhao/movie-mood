{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-boundary-risk-verifier.v1.2",
  "title": "Source Boundary Risk Verifier Semantic Output v1.2",
  "description": "Candidate semantic output schema for Verifier v1.2 under Option A contract hardening. CANDIDATE ONLY — NOT ACTIVE SCHEMA.",
  "metadata": {
    "status": "CANDIDATE_ONLY",
    "isActive": false,
    "isProductionAuthorized": false,
    "empiricalModelBehaviorNotYetValidated": true,
    "governanceState": "PAUSED_FOR_SEVERE_AUDIT_MISS",
    "supersedesSchema": "catalogue-pipeline/schemas/source-boundary-risk-verifier.v1.1.schema.json",
    "supersedesSchemaHash": "sha256:9e0647d3753e482ad23780725020f6bebb408486ba663596c0bb0fe562b06120",
    "lineageBindings": {
      "authorityModel": {
        "path": "catalogue-pipeline/specs/source-boundary-authority-model.v1.json",
        "hash": "sha256:a2b44aa6831c404fdb80d85040992ccdfeeca3d0552891e4c176853f9d48c6dd"
      },
      "schemaSpec": {
        "path": "catalogue-pipeline/specs/source-boundary-risk-verifier.v1.2.schema-spec.json",
        "hash": "sha256:504bc9e389da934e607302fb7ce0b7058711c1ae1cd519a794fe3ae4b44eca28"
      },
      "contractSpec": {
        "path": "catalogue-pipeline/specs/source-boundary-risk-verifier.v1.2.spec.md",
        "hash": "sha256:b12a45f2c1171deb7aab40095532c00e8ed12f444e363ec2529b3315a0b480ff"
      },
      "predecessorPrompt": {
        "path": "catalogue-pipeline/prompts/source-boundary-risk-verifier.v1.1.md",
        "hash": "sha256:361df6c2f5ca6feb3567c092e3f7bc5de7396f48b52e7a6c8afc9dbf00768123"
      },
      "predecessorSchema": {
        "path": "catalogue-pipeline/schemas/source-boundary-risk-verifier.v1.1.schema.json",
        "hash": "sha256:13edfc9ac97edf4f34739658b388706e8025727512e4fdb0671042c81d423947"
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "riskLevel",
    "riskCategories",
    "issues",
    "sourceBoundarySatisfied"
  ],
  "properties": {
    "riskLevel": {
      "type": "string",
      "enum": ["LOW_RISK", "HIGH_RISK"]
    },
    "riskCategories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "SPOILER_OR_LATER_REVEAL",
          "HIDDEN_IDENTITY_OR_ORIGIN",
          "RELATIONSHIP_OR_CHARACTER_MOTIVE",
          "CONCRETE_STORY_OR_SUPERNATURAL_MECHANISM",
          "FRANCHISE_OR_EXTERNAL_LORE",
          "SCENE_OR_SCRIPT_LEVEL_EXTERNAL_DETAIL",
          "MATERIAL_FACTUAL_CONFLICT",
          "UNRESOLVED_SOURCE_GROUNDING_CONFLICT",
          "UNSUPPORTED_COMPARATIVE_OR_META_CLAIM",
          "SPECULATIVE_HOOK_PREMISE",
          "UNAUTHORIZED_SOURCE_BOUNDARY_CLAIM"
        ]
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "field",
          "claimSpan",
          "normalizedClaim",
          "claimType",
          "checkedAuthoritySources",
          "sourceEvidence",
          "authorityResolution",
          "materialityRationale"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "SPOILER_OR_LATER_REVEAL",
              "HIDDEN_IDENTITY_OR_ORIGIN",
              "RELATIONSHIP_OR_CHARACTER_MOTIVE",
              "CONCRETE_STORY_OR_SUPERNATURAL_MECHANISM",
              "FRANCHISE_OR_EXTERNAL_LORE",
              "SCENE_OR_SCRIPT_LEVEL_EXTERNAL_DETAIL",
              "MATERIAL_FACTUAL_CONFLICT",
              "UNRESOLVED_SOURCE_GROUNDING_CONFLICT",
              "UNSUPPORTED_COMPARATIVE_OR_META_CLAIM",
              "SPECULATIVE_HOOK_PREMISE",
              "UNAUTHORIZED_SOURCE_BOUNDARY_CLAIM"
            ]
          },
          "field": {
            "type": "string",
            "enum": ["description", "whyWatch", "curiosityHook", "vibeSummary"]
          },
          "claimSpan": {
            "type": "string",
            "minLength": 1,
            "description": "Exact text substring excerpted from the copy containing the claim."
          },
          "normalizedClaim": {
            "type": "string",
            "minLength": 1,
            "description": "Concise factual proposition asserted or presupposed by the claim."
          },
          "claimType": {
            "type": "string",
            "enum": [
              "DIRECT_PACKET_FACT",
              "LANGUAGE_CLAIM",
              "NATIONALITY_OR_PRODUCTION_COUNTRY",
              "GENRE_OR_SUBGENRE",
              "STORY_SETUP_FACT",
              "LOCATION_OR_SETTING",
              "CHARACTER_RELATIONSHIP",
              "CHARACTER_MOTIVE_OR_GOAL",
              "CAUSAL_OR_STORY_MECHANISM",
              "TEMPORAL_OR_DURATION_CONSTRAINT",
              "QUANTITATIVE_CLAIM",
              "FRANCHISE_OR_EXTERNAL_LORE",
              "SPOILER_OR_LATER_REVEAL",
              "HIDDEN_IDENTITY_OR_ORIGIN",
              "VIEWING_EXPERIENCE_INFERENCE",
              "ATMOSPHERIC_OR_STYLISTIC_LANGUAGE",
              "SPECULATIVE_HOOK_PREMISE"
            ]
          },
          "checkedAuthoritySources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Authority surfaces checked in packet facts, overview, keywords, or boundary flags."
          },
          "sourceEvidence": {
            "type": "array",
            "minItems": 1,
            "description": "Concrete machine-auditable evidence from checked authority surfaces showing supporting value, conflicting value, or explicit absence of support.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "supportFound"],
              "properties": {
                "source": {
                  "type": "string",
                  "description": "Exact path or name of the authority surface checked (e.g. 'facts.spokenLanguages', 'allowedSourceMaterial.overview')."
                },
                "supportFound": {
                  "type": "boolean",
                  "description": "True if the source authorized/supported the claim; false if support was missing or contradicted."
                },
                "value": {
                  "description": "The exact source value, array, or excerpt found on the surface, if applicable."
                },
                "conflictingValue": {
                  "description": "The conflicting source value or excerpt that contradicts the claim, if applicable."
                },
                "notes": {
                  "type": "string",
                  "description": "Optional concise note explaining the source finding."
                }
              }
            }
          },
          "authorityResolution": {
            "type": "string",
            "enum": [
              "UNSUPPORTED_MISSING_AUTHORITY",
              "CONTRADICTED_BY_AUTHORITY",
              "DISALLOWED_AUTHORITY_SOURCE",
              "UNRESOLVED",
              "SUPPORTED"
            ],
            "description": "Resolution classification of why authority was unsatisfied."
          },
          "materialityRationale": {
            "type": "string",
            "minLength": 1,
            "description": "Why this issue represents a material source-boundary violation rather than harmless style."
          }
        }
      }
    },
    "lowRiskCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allVisibleFieldsAudited",
        "interrogativePremisesAudited",
        "factualModifiersAudited",
        "packetFactsAudited",
        "settingAndLocationAudited",
        "characterMotivesAndRelationshipsAudited",
        "storyMechanismsAndConstraintsAudited",
        "externalLoreAndBackstoryAudited",
        "spoilerAndRevealBoundariesAudited",
        "viewingExperienceInferenceAudited",
        "summaryRationale"
      ],
      "properties": {
        "allVisibleFieldsAudited": {
          "type": "boolean",
          "const": true
        },
        "interrogativePremisesAudited": {
          "type": "boolean",
          "const": true
        },
        "factualModifiersAudited": {
          "type": "boolean",
          "const": true
        },
        "packetFactsAudited": {
          "type": "boolean",
          "const": true
        },
        "settingAndLocationAudited": {
          "type": "boolean",
          "const": true
        },
        "characterMotivesAndRelationshipsAudited": {
          "type": "boolean",
          "const": true
        },
        "storyMechanismsAndConstraintsAudited": {
          "type": "boolean",
          "const": true
        },
        "externalLoreAndBackstoryAudited": {
          "type": "boolean",
          "const": true
        },
        "spoilerAndRevealBoundariesAudited": {
          "type": "boolean",
          "const": true
        },
        "viewingExperienceInferenceAudited": {
          "type": "boolean",
          "const": true
        },
        "summaryRationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceBoundarySatisfied": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "riskLevel": {
            "const": "LOW_RISK"
          }
        }
      },
      "then": {
        "required": [
          "lowRiskCoverage"
        ],
        "properties": {
          "riskCategories": {
            "maxItems": 0
          },
          "issues": {
            "maxItems": 0
          },
          "sourceBoundarySatisfied": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "riskLevel": {
            "const": "HIGH_RISK"
          }
        }
      },
      "then": {
        "properties": {
          "riskCategories": {
            "minItems": 1
          },
          "issues": {
            "minItems": 1
          },
          "sourceBoundarySatisfied": {
            "const": false
          }
        }
      }
    }
  ],
  "x-deterministicConsistencyRules": [
    "unique(issue.category values) == set(riskCategories)"
  ]
}
