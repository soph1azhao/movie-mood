      "id": "shared-covariate-contract.v2",
      "version": 1,
      "provenance": "new-v2-prospective-freeze",
      "canonicalContent": {
        "covariateType": "MODEL-DERIVED SEMANTIC COVARIATES",
        "purpose": "Freeze and reuse the three label-free Stage 4B covariates for both paired arms.",
        "semanticDefinition": { "promptId": "semantic-classifier.v3", "promptRawSha256": "sha256:be63a47c80b4247e09a2271f5be63b06add6d5ac6cd2496ad40d65d409f9076b", "schemaId": "semantic-output.v2", "schemaRawSha256": "sha256:50d7248a00d0d5a03d17e5611f57668bdc5a78b19d904d7a2c1986c44a5b7e52" },
        "providerConfiguration": { "provider": "kimi", "model": "k3-256k", "temperature": 1, "reasoningEffort": "high", "stateless": true },
        "statelessInvocationGuards": { "noConversationalHistory": true, "noSessionLinkage": true, "noAuthorshipWording": true },
        "requiredCompletions": 24,
        "outputs": ["pace", "emotionalWeight", "attentionDemand"],
        "providerVisibleInput": ["factual identity", "genres", "runtime", "countries", "languages", "factual source evidence"],
        "forbiddenProviderVisibleInput": ["Wikipedia", "descriptive evidence", "friendsGold", "confidence", "human rationale", "rationale seed", "prior arm result", "prior diagnostic result", "production editorial copy", "situations", "moods", "discoveryStyle"],
        "completionRule": "Exactly one canonical-valid completion is required per final-cohort candidate. Any transport ambiguity, missing completion, schema error, or invalid required axis is OPERATIONALLY_INCONCLUSIVE; no semantic retry, repair, replacement, or model substitution is permitted.",
        "pairedReuseRule": "Freeze a content-hashed per-candidate snapshot before Arm0; Arm0 and Arm1 must consume the exact same snapshot hash.",
        "dependenceDisclosure": "Stage4B covariates and friends decisions use the same configured model family; potential model-internal dependence is disclosed and is not a verdict gate."
      },
      "contentHash": "sha256:d4ca39a0101b5e6147a243b8afccfb7bfcd4eab61536d9f6d4d8cc0827b21334"
    },
