    {
      "id": "identity-canary-contract.v2",
      "version": 1,
      "provenance": "new-v2-prospective-freeze",
      "canonicalContent": {
        "selection": { "source": "frozen final 24", "trueCount": 3, "falseCount": 3, "preimage": "protocolId|identity-canary|canonicalId", "timing": "before semantic outcomes" },
        "providerConfiguration": { "provider": "kimi", "model": "k3-256k", "temperature": 1, "reasoningEffort": "high", "callsPerCandidate": 1, "stateless": true },
        "visibleInputs": ["opaque probe ID", "genres", "runtime", "countries", "languages", "frozen Stage4B covariates", "redactedNormalizedCanaryEvidence"],
        "forbiddenInputs": ["title", "year", "director", "canonicalId", "tmdbId", "friendsGold", "confidence", "human rationale", "prior prediction", "prior rationale", "prior grounding quote", "C1b result"],
        "redactionDictionary": {
          "freezeTiming": "at final-cohort freeze",
          "sources": ["canonicalId", "TMDB textual identity fields", "title", "original title", "director names already present in frozen metadata", "release year/date", "Wikipedia page title", "frozen known Wikipedia and source URLs", "cast names only when already present in frozen factual snapshot"],
          "noAdditionalTmdbCalls": true,
          "noAdditionalCastLookup": true,
          "noParaphrase": true
        },
        "normalizationAlgorithm": {
          "appliedTo": ["frozen accepted identity strings", "model guessedTitle"],
          "steps": [
            "1. Unicode normalize using NFKC",
            "2. Convert to Unicode lowercase using locale-independent default Unicode case conversion",
            "3. Replace every Unicode punctuation-category code point (\\p{P}) with one ASCII space",
            "4. Replace every Unicode whitespace sequence (\\s+) with one ASCII space",
            "5. Trim leading and trailing ASCII spaces"
          ],
          "noAccentStripping": true,
          "noTransliteration": true,
          "noFuzzyMatching": true,
          "noEditDistanceMatching": true,
          "noTokenReordering": true,
          "exactEqualityRequired": true
        },
        "canaryRedactionNormalization": {
          "appliedTo": ["every candidate-specific redaction-dictionary string", "the exact frozen Stage-6 Arm1 Wikipedia descriptive excerpt used as the Canary redaction source"],
          "steps": [
            "1. Unicode normalize using NFKC",
            "2. Convert to Unicode lowercase using locale-independent default Unicode case conversion",
            "3. Replace every Unicode punctuation-category code point (\\p{P}) with one ASCII space",
            "4. Replace every Unicode whitespace sequence (\\s+) with one ASCII space",
            "5. Trim leading and trailing ASCII spaces"
          ],
          "normalizedSourceName": "normalizedCanaryEvidence",
          "redactedResultName": "redactedNormalizedCanaryEvidence",
          "providerVisibleWikipediaEvidence": "redactedNormalizedCanaryEvidence only",
          "stage6Arm1InputMutationAllowed": false,
          "scope": "Canary only"
        },
        "unicodeExecutionEnvironment": {
          "nodeRuntimeVersion": "v26.7.0",
          "unicodeVersion": "17.0",
          "icuVersion": "78.3",
          "mismatchDisposition": "CANARY_EXECUTION_ENVIRONMENT_MISMATCH before any Canary model call"
        },
        "redactionMatchingAlgorithm": {
          "source": "normalizedCanaryEvidence",
          "dictionary": "candidate-specific entries after canaryRedactionNormalization",
          "result": "redactedNormalizedCanaryEvidence",
          "steps": [
            "1. Discard empty normalized dictionary entries",
            "2. Deduplicate identical normalized dictionary entries",
            "3. Sort entries: descending normalized Unicode code-point length; lexicographic ascending for equal lengths",
            "4. Apply longest-first matching",
            "5. A match start is eligible only at string start or when the immediately preceding Unicode code point is not General_Category Letter (L*) or Number (N*); a match end is eligible only at string end or when the immediately following Unicode code point is not General_Category Letter (L*) or Number (N*)",
            "6. Replace every matched span with [REDACTED_IDENTITY]",
            "7. Apply all replacements deterministically",
            "8. Do not paraphrase surrounding text",
            "9. Do not make model-assisted redaction decisions"
          ],
          "replacementToken": "[REDACTED_IDENTITY]",
          "regexWordBoundaryNormative": false,
          "noModelAssistedRedaction": true
        },
        "acceptedIdentitySet": "frozen TMDB title and original_title only; no post-hoc alias additions",
        "noPostHocAliases": true,
        "outputSchema": { "guessedTitle": "string", "confidence": "integer 0..100", "briefBasis": "string" },
        "positiveRule": "normalized guessedTitle matches the frozen accepted identity set AND confidence >= 80",
        "completionRule": "All six one-shot calls must be canonical-valid; no retry, replacement, denominator shrink, or model change. Any failure is CANARY_OPERATIONALLY_INCONCLUSIVE.",
        "interpretation": { "semanticVerdictMutable": false, "caveatThreshold": "4/6 positive", "promotionGoEffect": "Phase 6 HOLD pending a future independent strict 200..800 vote-count-band study", "futureStudyAutomatic": false }
      },
      "contentHash": "sha256:9c2e12c8e3952ef00f83837ac5eff1194c091305a81779d9a5606b51a776ebd7"
    },
