        "redactionMatchingAlgorithm": {
          "source": "normalizedCanaryEvidence",
          "dictionary": "candidate-specific entries after canaryRedactionNormalization",
          "result": "redactedNormalizedCanaryEvidence",
          "steps": [
            "1. Discard empty normalized dictionary entries",
            "2. Deduplicate identical normalized dictionary entries",
            "3. Sort entries: descending normalized Unicode code-point length; lexicographic ascending for equal lengths",
            "4. Apply longest-first matching",
            "5. A match start is eligible only at string start or when the immediately preceding Unicode code point is not General_Category Letter (L*) or Number (N*); a match end is eligible only at string end or when the immediately following Unicode code point is not General_Category Letter (L*) or Number (N*)",
            "6. Replace every matched span with [REDACTED_IDENTITY]",
            "7. Apply all replacements deterministically",
            "8. Do not paraphrase surrounding text",
            "9. Do not make model-assisted redaction decisions"
