  "studyEstimands": {
    "coverage": {
      "name": "Wikipedia evidence viability over the frozen fresh factual candidate universe",
      "denominator": 180,
      "formula": "viableWikipediaEvidenceCount / 180",
      "exactObservedFrozenUniverseCoverage": "k / 180",
      "descriptiveBinomialReferenceOnly": true,
      "populationInferenceAuthorized": false,
      "fullCatalogueConfidenceInterval": false,
      "wilsonIntervalInterpretation": "Descriptive reference for the observed frozen 180-candidate universe only. Cannot be interpreted as a catalogue-level or population-level confidence interval.",
      "reports": [
        "pointEstimate",
        "wilson95Interval",
        "identityResolutionRate",
        "allowedSectionRate",
        "eligibleNormalizedWordCountAtLeast150Rate",
        "failureReasonDistribution",
        "coverageByFactualStrata"
      ],
      "wilsonInterval": {
        "confidenceLevel": 0.95,
        "z": 1.959963984540054,
        "method": "Wilson score interval without continuity correction"
      },
      "factualStrata": [
        "releaseDecade",
        "voteCountBand",
        "language",
        "country",
        "genre",
        "runtimeBand"
      ],
      "coverageByFriendsGold": "NOT_IDENTIFIABLE_IN_MAIN_V2_DESIGN",
      "screeningOccursBeforeHumanGold": true
    },
    "efficacy": {
      "name": "Incremental semantic value of Wikipedia reception evidence conditional on deterministic evidence eligibility",
      "population": "final evidence-eligible confirmatory cohort",
      "entireMovieMoodCatalogueEstimand": false,
      "independentFromCoverageEstimand": true
    }
  },
  "stages": [
    {
      "stage": 0,
      "id": "crash-safe-execution-substrate",
      "hardPrerequisiteForLaterNetworkedStages": true,
      "wal": {
        "lifecycle": ["INTENT", "RESPONSE", "TERMINAL"],
        "commonRequiredIdentityFields": ["studyId", "invocationId", "attemptId", "stage", "requestScope", "requestPurpose", "requestHash", "attemptOrdinal", "timestamp"],
        "scopeConditionalIdentityFields": {
          "universe": {
            "scopeId": "required",
            "candidateId": null,
            "arm": null,
            "drawIndex": null
          },
          "candidate": {
            "scopeId": "optional-null",
            "candidateId": "required",
            "arm": null,
            "drawIndex": null
          },
          "inference": {
            "scopeId": "optional-null",
            "candidateId": "required",
            "arm": "required",
            "drawIndex": "required"
          }
        },
        "allowedRequestScopeValues": ["universe", "candidate", "inference"],
        "hashChainFields": ["seq", "prevRecordHash", "canonicalRecordHash"],
        "hashAlgorithm": "SHA-256",
        "dispatchOrdering": ["append INTENT", "fsync WAL file", "dispatch network request"],
        "responseOrdering": ["append RESPONSE", "fsync WAL file", "advance parsing/state"],
        "terminalOrdering": ["append TERMINAL", "fsync WAL file", "advance completed state"],
        "criticalAtomicArtifactReplacement": ["write temporary file", "fsync temporary file", "atomic rename", "fsync parent directory"]
      },
      "tornWritePolicy": {
        "trailingIncompleteRecord": "TORN_TRAILING_RECORD",
        "recoveryReadScope": "last-valid-hash-chain-prefix-only",
        "preserveOriginalWal": true,
        "destructiveTruncationOrRewrite": false,
        "interiorHashChainOrChecksumFailure": "WAL_CORRUPTION",
        "interiorFailureOutcome": "OPERATIONALLY_INCONCLUSIVE"
      },
      "ambiguousDispatchPolicy": {
        "unknownInFlightDefinition": "durable INTENT plus request may have been dispatched plus no durable RESPONSE",
        "unknownInFlightOutcome": "OPERATIONALLY_INCONCLUSIVE",
        "automaticRetry": false,
        "manualReplacementDraw": false,
        "compensationDraw": false,
        "ambiguousStochasticReplacementsAllowed": 0,
        "provablyNotDispatchedDefinition": "failure is durably recorded as TERMINAL before transport dispatch",
        "provablyNotDispatchedMayUseFrozenTransportRetry": true,
        "crashAfterIntentBeforeDispatchWithoutDurableTerminal": "UNKNOWN_IN_FLIGHT"
      },
      "runLock": {
        "acquisition": "exclusive-create",
        "durability": ["fsync lock file", "fsync parent directory"],
        "automaticTtlClearing": false,
        "staleLockDisposition": "explicit-controlled-recovery-review"
      },
      "requiredSyntheticPreflightScenarios": [
        "crash-before-INTENT",
        "crash-after-INTENT-before-dispatch",
        "crash-after-possible-dispatch-before-RESPONSE",
        "crash-after-RESPONSE-before-parse",
        "crash-after-parse-before-TERMINAL",
        "torn-trailing-WAL-record",
        "interior-WAL-corruption",
        "double-runner-launch",
        "stale-lock",
        "completed-run-replay"
      ],
      "centralInvariant": "no ambiguous state may silently cause a new network request"
    },
    {
      "stage": 1,
      "id": "fresh-factual-candidate-universe",
      "candidateCount": 180,
      "stage1RecruitmentContractRef": "stage1-recruitment-contract.v2",
      "stage1RecruitmentContractHash": "sha256:d1f582143b24c3e30c223f809bf55c24b00da24752fe70fed4a7330b7764473e",
      "temporalStrata": [
        { "id": "1980-1989", "count": 24 },
        { "id": "1990-1999", "count": 24 },
        { "id": "2000-2009", "count": 33 },
        { "id": "2010-2019", "count": 45 },
        { "id": "2020-2024", "count": 54 }
      ],
      "factualEligibility": {
        "tmdbVoteCountMinInclusive": 200,
        "tmdbVoteCountMaxInclusive": 2000,
        "releaseDateMaxInclusive": "2024-12-31"
      },
      "distributionPolicy": {
        "languageQuotas": false,
        "countryQuotas": false,
        "genreQuotas": false,
        "languageCountryGenreAreDisclosureOnly": true
      },
      "absolutePriorExposureIsolation": {
        "excludeUnionOf": [
          "all films materialized into either C1b-V1 Stage-1 registry",
          "all C1b-V1 human-gold candidates",
          "all C1b-V1 Wikipedia-exposed candidates",
          "all C1b-V1 incident/resolution candidates",
          "all earlier Phase-5 semantic/development exposure-ledger entries",
          "all other prior semantic/descriptive-evidence exposures"
        ],
        "broadTmdbDiscoveryPageAppearanceAloneIsExclusion": false,
        "deterministicExclusionManifestRequired": true,
        "exclusionManifestHashRequired": true
      },
      "crossStratumQuotaBorrowing": false,
      "replenishmentBatchAllowed": false,
      "insufficientStratumStatus": "BLOCKED — INSUFFICIENT FRESH FACTUAL UNIVERSE"
    },
    {
      "stage": 2,
      "id": "machine-only-wikipedia-viability",
      "occursBeforeHumanGold": true,
      "labelerMaySeeEvidenceTextOrViabilityMetadata": false,
      "policies": {
        "identityResolution": "wikipedia-film-identity-resolution.v1",
        "sectionFamily": "wikipedia-reception-sections.v2",
        "extraction": "wikipedia-reception-extraction.v2",
        "normalizationFilter": "wikipedia-reception-normalization-filter.v1",
        "preserveExistingParagraphFiltering": true,
        "preserveExistingProvenanceRequirements": true
      },
      "viability": {
        "eligibleNormalizedWordCountMinInclusive": 150,
        "countCalculatedBeforeInferenceExcerptTruncation": true,
        "terminalValues": ["VIABLE", "NON_VIABLE"]
      },
      "completionGate": {
        "requiredDeterminateCandidateCount": 180,
        "prohibitedOutstandingStates": ["UNKNOWN_IN_FLIGHT", "unresolved-transport-state", "unresolved-provenance-state", "unresolved-technical-status"],
        "failureStatus": "BLOCKED — COVERAGE EXECUTION INCOMPLETE",
        "stage3AuthorizedOnlyAfterPass": true
      },
      "producesFrozenCoverageResult": true
    },
    {
      "stage": 3,
      "id": "evidence-blinded-sequential-human-gold",
      "inputPopulation": "Wikipedia-VIABLE candidates only",
      "goldProvenance": ["independent-human", "evidence-blinded", "pre-semantic-model"],
      "requiredMetadata": {
        "machineEvidenceFetchedBeforeGold": true,
        "labelerExposedToEvidence": false,
        "semanticModelOutputSeenBeforeGold": false
      },
      "ordering": {
        "algorithm": "SHA-256 lexicographic ascending",
        "preimage": "protocolId + \"|human-label|\" + canonicalId"
      },
      "labelerVisible": "neutral-factual-information-only",
      "labelerForbidden": ["Wikipedia heading", "Wikipedia word count", "Wikipedia evidence", "evidence hash", "semantic-model output", "current true/false class counts", "current target deficits"],
      "humanFields": {
        "friendsGold": [true, false],
        "confidence": ["high", "medium", "low"],
        "rationaleSeed": { "required": false, "maxUnicodeCodePoints": 80 }
      },
      "rationaleSeedForbiddenUses": ["provider-visible", "semantic evidence", "cohort-selection input", "verdict input"],
      "sequentialLabeling": {
        "initialTranche": 48,
        "increment": 8,
        "checkpoints": [48, 56, 64, 72],
        "maxLabelBudget": 72,
        "internalCheckpointPredicate": "highMediumTrue >= 12 AND highMediumFalse >= 12",
        "humanFacingResponses": ["STOP — GOLD TARGET REACHED", "CONTINUE — NEXT PRE-REGISTERED TRANCHE"],
        "revealClassCountsDuringLabeling": false,
        "stopAtFirstPassingCheckpoint": true,
        "maxBudgetFailure": "BLOCKED — INSUFFICIENT HIGH/MED GOLD CLASS COUNT",
        "viablePoolExhaustionFailure": "BLOCKED — EVIDENCE-ELIGIBLE POOL EXHAUSTED",
        "additionalMiningAllowed": false
      },
      "lowConfidenceArchive": {
        "path": "c1b-v2-boundary-pool.json",
        "beforeFinalSemanticVerdict": {
          "mayBeStored": true,
          "mayBeCounted": true,
          "mayBeAnalyzed": false,
          "mayBeUsedForPromptChanges": false,
          "mayBeUsedAsSemanticExamples": false,
          "mayBeExposedToSemanticModels": false
        }
      }
    },
    {
      "stage": 4,
      "id": "label-freeze-and-final-cohort",
      "freezeAllCompletedStage3Fields": ["friendsGold", "confidence", "rationaleSeed"],
      "selection": {
        "algorithm": "SHA-256 lexicographic ascending within high/medium gold classes",
        "preimage": "protocolId + \"|final-cohort|\" + canonicalId",
        "friendsTrueCount": 12,
        "friendsFalseCount": 12,
        "total": 24
      },
      "postSelectionHumanFieldsForFinal24": {
        "humanRationale": "required",
        "reflectionChanged": "boolean",
        "mayDisplayRationaleSeed": true
      },
      "immutableAfterSelection": ["friendsGold", "confidence", "final cohort"],
      "reflectionChangedIsDisclosureOnly": true,
      "reflectionChangedForbiddenEffects": ["gold", "confidence", "cohort membership", "inference", "verdict"],
      "stage4B": {
        "id": "shared-covariate-inference",
        "covariateType": "MODEL-DERIVED SEMANTIC COVARIATES",
        "description": "Stateless one-shot covariate calls for every final-24 candidate. Executed after Stage 4A label-freeze and before Arm0 begins.",
        "outputs": ["pace", "emotionalWeight", "attentionDemand"],
        "provider": "kimi",
        "model": "k3-256k",
        "temperature": 1,
        "reasoningEffort": "high",
        "stateless": true,
        "noConversationalHistory": true,
        "noSessionLinkage": true,
        "noAuthorshipWording": true,
        "requiredCompletions": 24,
        "callsPerCandidate": 1,
        "forbidden": ["Wikipedia evidence", "friendsGold", "confidence", "rationaleSeed", "humanRationale"],
        "completionRule": "Exactly one canonical-valid completion per final-cohort candidate. Any transport ambiguity, missing completion, schema error, or invalid required axis is OPERATIONALLY_INCONCLUSIVE; no retry, repair prompt, or replacement call.",
        "unknownInFlightOutcome": "OPERATIONALLY_INCONCLUSIVE",
        "invalidOrMissingOutputOutcome": "OPERATIONALLY_INCONCLUSIVE",
        "pairedReuseRule": "Exact frozen covariate snapshot (content-hashed per candidate) used identically by Arm0 and Arm1.",
        "contractRef": "shared-covariate-contract.v2",
        "contractHash": "sha256:d4ca39a0101b5e6147a243b8afccfb7bfcd4eab61536d9f6d4d8cc0827b21334"
      }
    },
    {
      "stage": 5,
      "id": "arm0",
      "inference": {
        "provider": "kimi",
        "model": "k3-256k",
        "temperature": 1,
        "reasoningEffort": "high",
        "drawsPerFilm": 3,
        "aggregation": "strict-boolean-2-of-3-majority",
        "requiredDraws": 72,
        "liveExecution": "stochastic",
        "completedReplay": "immutable-per-draw-cache"
      },
      "drawIdentityFields": ["protocolId", "candidateId", "arm", "drawIndex", "provider", "model", "output-affecting configuration", "prompt", "schema", "canonical input hash", "WAL invocation identity"],
      "distinctLiveDrawIdentitiesRequired": 3,
      "completedDrawReplayModelCalls": 0,
      "fourthDrawAllowed": false,
      "confidenceWeightingAllowed": false,
      "rationaleVotingAllowed": false,
      "requiredDrawUnknownInFlightOutcome": "OPERATIONALLY_INCONCLUSIVE",
      "aggregatePredictionCount": 24,
      "arm0ErrorsFormula": "FP + FN over 24 aggregated majority predictions",
      "friendsClassificationContractRef": "friends-classification-contract.v2",
      "friendsClassificationContractHash": "sha256:dd9e28bbc17a5120438ae8eb3df42067bc9c33ba43e553cfd0b72567fb1750d6",
      "semanticTaxonomyRef": "semantic-taxonomy.v2",
      "semanticTaxonomyHash": "sha256:27f401884c929964ef7cdb4cc59dc9177b5a5683b964e09677061ab66e6492f4",
      "arm0InputProjectionRef": "arm0-input-projection.v2",
      "arm0InputProjectionHash": "sha256:d7e360cf3ded8b1c9c94f36c00f774cf8c34a77fbf9b1a9ef96eab2ef24cd18a",
      "headroom": {
        "minimumErrorsInclusive": 5,
        "failureStatus": "INCONCLUSIVE — INSUFFICIENT BASELINE HEADROOM",
        "arm1ProhibitedOnFailure": true
      }
    },
    {
      "stage": 6,
      "id": "arm1",
      "prerequisite": "Stage 5 headroom passes",
      "requiredDraws": 72,
      "drawsPerFilm": 3,
      "pairedInputInvariant": "Arm1 provider-visible semantic input equals exact Arm0 semantic input plus frozen Wikipedia descriptive-evidence block",
      "otherSemanticInputDifferencesAllowed": false,
      "literalGroundingValidationRequiredPerDraw": true,
      "invalidOrMissingRequiredDrawOutcome": "OPERATIONALLY_INCONCLUSIVE",
      "additionalRescueDrawsAllowed": false,
      "arm1EvidenceProjectionRef": "arm1-evidence-projection.v2",
      "arm1EvidenceProjectionHash": "sha256:c1770e3843f9c3ad8e6004cc88b061223b88431734abbf2c40de2e53270f0ca5",
      "wikipediaExcerptProjectionRef": "wikipedia-excerpt-projection.v2",
      "wikipediaExcerptProjectionHash": "sha256:26f65ad2dc5d2a4734ca5ff1eb1a705dee85a5e2119635803d388af1aeec52f0",
      "literalGroundingValidatorRef": "literal-grounding-validator.v2",
      "literalGroundingValidatorHash": "sha256:1eeb33a6e5b623f03af3965d1e5c8ac4fdbf13e0995f36df854afb1133f10851"
    },
    {
      "stage": 7,
      "id": "frozen-efficacy-verdict",
      "precedence": [
        { "order": 1, "when": "operational or contract failure", "verdict": "OPERATIONALLY INCONCLUSIVE" },
        { "order": 2, "when": "arm0Errors < 5", "verdict": "INCONCLUSIVE — INSUFFICIENT BASELINE HEADROOM" },
        { "order": 3, "when": "introducedErrors > correctedErrors OR introducedFalsePositives >= 3", "verdict": "EVIDENCE DEFECT — NO-GO" },
        { "order": 4, "when": "correctedErrors >= 3 AND introducedErrors <= 1 AND netErrorReduction >= 2 AND arm1F1 > arm0F1 AND arm1Precision >= 0.80 AND arm1Recall >= 0.75", "verdict": "PROMOTION GO" },
        { "order": 5, "when": "correctedErrors >= 2 AND netErrorReduction > 0", "verdict": "PARTIAL / HOLD" },
        { "order": 6, "when": "otherwise", "verdict": "NO MATERIAL BENEFIT" }
      ],
      "requiredMetrics": ["TP", "FP", "FN", "TN", "precision", "recall", "F1", "specificity", "balancedAccuracy", "correctedErrors", "introducedErrors", "introducedFP", "introducedFN", "netErrorReduction", "exactPairedMcNemarBinomialDiscordantPairStatistic", "exactPairedMcNemarBinomialPValue"],
      "mcnemarRole": "descriptive-only"
    },
    {
      "stage": 8,
      "id": "identity-canary",
      "selectionTiming": "preselected before semantic outcomes exist",
      "executionTiming": "after main efficacy result",
      "selection": {
        "source": "final 24",
        "friendsTrueCount": 3,
        "friendsFalseCount": 3,
        "distinctFrozenHashNamespaceRequired": true
      },
      "reidentificationPositive": "correct canonical identity AND confidence >= 80",
      "caveatThresholdInclusive": 4,
      "caveatDenominator": 6,
      "caveat": "COHORT VALIDITY CAVEAT",
      "altersSemanticVerdict": false,
      "promotionGoConsequence": "Phase-6 production authorization conditional on a future independent strict-band validation study",
      "identityCanaryContractRef": "identity-canary-contract.v2",
      "identityCanaryContractHash": "sha256:9c2e12c8e3952ef00f83837ac5eff1194c091305a81779d9a5606b51a776ebd7",
      "futureStrictBandStudy": {
        "tmdbVoteCountMinInclusive": 200,
        "tmdbVoteCountMaxInclusive": 800,
        "automaticallyExecutedByV2": false
      }
    }
  ],
