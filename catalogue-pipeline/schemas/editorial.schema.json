{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial.schema.json",
  "title": "Movie Mood Editorial Output",
  "type": "object",
  "required": ["schemaVersion", "promptVersion", "voiceGuideVersion", "movie", "copy", "writerNotes"],
  "properties": {
    "schemaVersion": { "const": "editorial-output.v1" },
    "promptVersion": { "type": "string", "minLength": 1 },
    "voiceGuideVersion": { "type": "string", "minLength": 1 },
    "movie": { "type": "object", "required": ["candidateId", "tmdbId"] },
    "copy": { "type": "object", "required": ["description", "whyWatch", "curiosityHook", "vibeSummary"] },
    "writerNotes": {
      "type": "object",
      "required": ["spoilerBoundary"],
      "properties": {
        "spoilerBoundary": {
          "type": "object",
          "required": ["allowedMaterial", "excludedMaterial", "sourceRefs"],
          "properties": {
            "allowedMaterial": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "excludedMaterial": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
