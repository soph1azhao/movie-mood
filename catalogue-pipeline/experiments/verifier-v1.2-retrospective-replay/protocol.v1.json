      "STOP_MODEL_CONFIG_MISMATCH",
      "STOP_IF_SCHEMA_OR_SEMANTIC_INVALID_COUNT_GTE_6"
    ],
    "systemicSchemaFailureRule": {
      "ruleId": "STOP_IF_SCHEMA_OR_SEMANTIC_INVALID_COUNT_GTE_6",
      "thresholdCount": 6,
      "thresholdPercentage": ">=20% of 30-record cohort",
      "includedDispositions": [
        "SCHEMA_INVALID",
        "SEMANTICALLY_INVALID"
      ],
      "excludedDispositions": [
        "PROVIDER_FAILURE",
        "MALFORMED_JSON_RETRYABLE_TRANSPORT"
      ],
      "definition": "Halts replay immediately if 6 or more records produce SCHEMA_INVALID or SEMANTICALLY_INVALID model outputs across the cohort."
    }
  },
  "outputValidationPipeline": {
    "step1": "JSON.parse() of response text",
    "step2": "Schema validation against source-boundary-risk-verifier.v1.2.schema.json",
    "step3": "Semantic validation against validateVerifierV12CandidatePayload",
    "failClosedRule": "Invalid or unparseable outputs map to failure dispositions and are never coerced into LOW_RISK."
  },
  "evaluationFramework": {
    "dispositionClasses": [
      "VALID_HIGH_RISK",
      "VALID_LOW_RISK",
      "INVALID_OR_PROVIDER_FAILURE"
    ],
    "invalidOrFailureSubtypes": [
      "PROVIDER_FAILURE",
      "MALFORMED_JSON",
      "SCHEMA_INVALID",
      "SEMANTICALLY_INVALID"
    ],
    "layerA_SemanticVerifierPerformance": {
      "layerId": "VALID_OUTPUT_APPARENT_RETROSPECTIVE_PERFORMANCE",
      "question": "Did the verifier return a valid semantic judgment?",
      "scope": "Evaluated strictly on valid outputs (disposition in [VALID_HIGH_RISK, VALID_LOW_RISK]). Failures and invalid outputs are excluded from the semantic confusion matrix and reported separately.",
      "groundTruthBasis": "Effective human review decisions with approved Guardians correction",
      "positiveDefinition": "Human REVISE (N=16 total in cohort: 15 minor, 1 severe)",
      "negativeDefinition": "Human APPROVE (N=14 total in cohort)",
      "confusionMatrixDefinitions": {
        "TP": "Human REVISE + VALID_HIGH_RISK",
        "FN": "Human REVISE + VALID_LOW_RISK",
        "FP": "Human APPROVE + VALID_HIGH_RISK",
        "TN": "Human APPROVE + VALID_LOW_RISK"
      },
      "reportingRequirements": [
        "validOutputCount",
        "invalidOrFailureCount",
        "validOutputRate",
        "apparentDefectSensitivity",
        "apparentSpecificity",
        "apparentPpv",
        "apparentNpv",
        "apparentFalsePositiveRate"
      ],
      "prohibition": "Failures must never be counted as TP or TN and must never be silently removed from reporting."
    },
    "layerB_OperationalFailClosedContainment": {
      "layerId": "FAIL_CLOSED_OPERATIONAL_CONTAINMENT",
      "question": "Would the system prevent unsafe automatic passage?",
      "routingSimulation": {
        "VALID_HIGH_RISK": "HUMAN_REVIEW_REQUIRED",
        "INVALID_OR_PROVIDER_FAILURE": "HUMAN_REVIEW_REQUIRED / FAIL_CLOSED",
        "VALID_LOW_RISK": "AUTO_ELIGIBLE_SIMULATION"
      },
      "reportingRequirements": {
        "defectContainmentCountAndRate": "Human REVISE records routed to HUMAN_REVIEW_REQUIRED (either VALID_HIGH_RISK or FAIL_CLOSED)",
        "cleanAutoPassCountAndRate": "Human APPROVE records routed to AUTO_ELIGIBLE_SIMULATION (VALID_LOW_RISK)",
        "cleanOverRoutingCountAndRate": "Human APPROVE records routed to HUMAN_REVIEW_REQUIRED (VALID_HIGH_RISK or FAIL_CLOSED)",
        "totalHumanReviewRoutingBurden": "Total records routed to HUMAN_REVIEW_REQUIRED / total cohort size"
      },
      "prohibition": "Operational containment due to failure/invalid output MUST NEVER be described as semantic defect detection or true positive."
    },
    "severityAnalysis": {
      "minorCasesTotal": 15,
      "severeCasesTotal": 1,
      "severeCaseCandidateId": "scale500-tmdb-14283",
      "severeCaseOutcomeMetric": "SEVERE_CASE_OUTCOME",
      "governanceSafetyGateTrigger": "If scale500-tmdb-14283 receives VALID_LOW_RISK, record KNOWN_SEVERE_FAILURE_PASSED_CANDIDATE and maintain PAUSED_FOR_SEVERE_AUDIT_MISS."
    }
